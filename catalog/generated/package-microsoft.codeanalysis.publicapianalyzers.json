		{
			"id": "RS0036",
			"source": "Microsoft.CodeAnalysis.PublicApiAnalyzers",
			"title": "Annotate nullability of public types and members in the declared API",
			"category": "ApiDesign",
			"defaultSeverity": "warning",
			"isEnabledByDefault": true,
			"helpLink": "https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md",
			"description": "All public types and members should be declared with nullability annotations in PublicAPI.txt. This draws attention to API nullability changes in the code reviews and source control history, and helps prevent breaking changes.",
			"tags": [
				"Telemetry"
			],
			"hasCodeFix": true,
			"warningLevel": null,
			"parameters": []
		},
		{
			"id": "RS0037",
			"source": "Microsoft.CodeAnalysis.PublicApiAnalyzers",
			"title": "Enable tracking of nullability of reference types in the declared API",
			"category": "ApiDesign",
			"defaultSeverity": "warning",
			"isEnabledByDefault": true,
			"helpLink": "https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md",
			"description": "PublicAPI.txt files should have `#nullable enable` to track nullability information, or this diagnostic should be suppressed. With nullability enabled, PublicAPI.txt records which types are nullable (suffix `?` on type) or non-nullable (suffix `!`). It also tracks any API that is still using an oblivious reference type (prefix `~` on line).",
			"tags": [
				"Telemetry"
			],
			"hasCodeFix": true,
			"warningLevel": null,
			"parameters": []
		},
		{
			"id": "RS0041",
			"source": "Microsoft.CodeAnalysis.PublicApiAnalyzers",
			"title": "Public members should not use oblivious types",
			"category": "ApiDesign",
			"defaultSeverity": "warning",
			"isEnabledByDefault": true,
			"helpLink": "https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md",
			"description": "All public members should use either nullable or non-nullable reference types, but no oblivious reference types.",
