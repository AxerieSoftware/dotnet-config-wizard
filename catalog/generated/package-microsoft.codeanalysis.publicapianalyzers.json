{
	"id": "Microsoft.CodeAnalysis.PublicApiAnalyzers",
	"version": "5.6.0",
	"rules": [
		{
			"id": "RS0016",
			"source": "Microsoft.CodeAnalysis.PublicApiAnalyzers",
			"title": "Add public types and members to the declared API",
			"category": "ApiDesign",
			"defaultSeverity": "warning",
			"isEnabledByDefault": true,
			"helpLink": "https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md",
			"description": "All public types and members should be declared in PublicAPI.txt. This draws attention to API changes in the code reviews and source control history, and helps prevent breaking changes.",
			"tags": [
				"Telemetry"
			],
			"hasCodeFix": true,
			"warningLevel": null,
			"parameters": []
		},
		{
			"id": "RS0017",
			"source": "Microsoft.CodeAnalysis.PublicApiAnalyzers",
			"title": "Remove deleted types and members from the declared API",
			"category": "ApiDesign",
			"defaultSeverity": "warning",
			"isEnabledByDefault": true,
			"helpLink": "https://github.com/dotnet/roslyn/blob/main/src/RoslynAnalyzers/PublicApiAnalyzers/PublicApiAnalyzers.Help.md",
			"description": "When removing a public type or member, put that entry in PublicAPI.Unshipped.txt with '*REMOVED*' prefix. This draws attention to API changes in the code reviews and source control history, and helps prevent breaking changes.",
			"tags": [
				"CompilationEnd",
				"Telemetry"
