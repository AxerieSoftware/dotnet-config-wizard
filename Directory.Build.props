<Project>
	<PropertyGroup Label="Language">
		<!-- Nullable reference types. -->
		<Nullable>enable</Nullable>
		<!-- Global usings for common namespaces. -->
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup Label="Analysis">
		<!-- Which .NET analyzer rules are on; latest-<mode> tracks the SDK. -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<!-- Runs IDE code-style rules on build, not just in the editor. -->
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<!-- Writes XML docs, which IDE0005 needs to run on build. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Label="Reproducible builds">
		<!-- The same inputs always produce the same binary. -->
		<Deterministic>true</Deterministic>
		<!-- Puts every project's bin and obj under one artifacts folder. -->
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<!-- Runs with invariant culture, without ICU. -->
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<PropertyGroup Label="Continuous integration" Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup Label="CI builds only" Condition="'$(ContinuousIntegrationBuild)' == 'true'">
		<!-- Turns every compiler and analyzer warning into an error. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
</Project>
