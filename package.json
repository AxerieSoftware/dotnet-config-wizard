{
	"name": "dotnet-config-wizard",
	"private": true,
	"license": "MIT",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run typecheck && npm run lint && npm run knip && npm test",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"knip": "knip",
		"test": "vitest run",
		"e2e": "playwright test",
		"catalog": "node scripts/buildCatalog.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "26.6.5",
		"knip": "6.42.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"description": "Wizard for .editorconfig, Directory.Build.props and analyzer configuration in .NET repos.",
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"@fluentui/svg-icons": "1.1.344",
		"@fontsource/cascadia-code": "5.3.0",
		"fflate": "0.8.3",
		"lz-string": "1.5.0",
		"shiki": "4.5.0"
	}
}
