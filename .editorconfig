# Settings for .NET SDK 10.0.3xx
root = true

#### All files ####
[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

#### Markdown ####
[*.md]
trim_trailing_whitespace = false

#### YAML ####
[*.{yml,yaml}]
indent_style = space
indent_size = 2

#### Windows scripts ####
[*.{cmd,bat}]
end_of_line = crlf

#### C# files ####
[*.cs]
## Organize usings (IDE0055)
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true

## this. and Me. qualification (IDE0003, IDE0009)
dotnet_style_qualification_for_event = true
dotnet_style_qualification_for_field = true
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_property = true

## Language keywords instead of framework type names (IDE0049)
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true

## Expression-level preferences (IDE0028, IDE0300, IDE0301, IDE0302, IDE0303, IDE0304, IDE0305, IDE0306)
dotnet_style_prefer_collection_expression = when_types_loosely_match

## var preferences (IDE0007, IDE0008)
csharp_style_var_elsewhere = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true

## Code blocks (IDE0160, IDE0161)
csharp_style_namespace_declarations = file_scoped

## New lines (IDE0055)
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_open_brace = all

### Diagnostic severities ###
## Code style: Style
# IDE0003: Name can be simplified (editor only)
dotnet_diagnostic.IDE0003.severity = warning
# IDE0005: Using directive is unnecessary
dotnet_diagnostic.IDE0005.severity = warning
# IDE0007: Use implicit type
dotnet_diagnostic.IDE0007.severity = warning
# IDE0009: Member access should be qualified
dotnet_diagnostic.IDE0009.severity = warning
# IDE0049: Use language keywords instead of framework type names for type references (editor only)
dotnet_diagnostic.IDE0049.severity = warning
# IDE0055: Fix formatting
dotnet_diagnostic.IDE0055.severity = warning
# IDE0161: Convert to file-scoped namespace
dotnet_diagnostic.IDE0161.severity = warning
# IDE0300: Simplify collection initialization
dotnet_diagnostic.IDE0300.severity = warning
